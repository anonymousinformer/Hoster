<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Hoster</AssemblyName>
    <ApplicationIcon>Hoster.ico</ApplicationIcon>
    <RootNamespace>Hoster</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>                  <!-- precompiled code: biggest start-up win, less JIT while running -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <TieredPGO>false</TieredPGO>                                 <!-- skip profiling overhead while warming up -->
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <DebugType>none</DebugType>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>   <!-- no extra GC thread at start -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>  <!-- fewer files to load -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
</Project>